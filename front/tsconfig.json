{
	"compilerOptions": {
		"module": "esnext",
		"target": "es2022",
		"moduleResolution": "bundler",
		"paths": {
			"#*": [
				"./src/*"
			]
		},
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": false,
		"noEmit": true,
		"jsx": "react",
		"jsxFactory": "h",
		"jsxFragmentFactory": "Fragment",
		"types": [
			"@wxn0brp/flanker-ui",
			"esbuild-style-plugin",
			"@types/vhtml"
		]
	},
	"include": [
		"./src"
	],
	"exclude": [
		"node_modules"
	]
}
